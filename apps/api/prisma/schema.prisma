generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String?
  passwordHash String
  role         Role
  departmentId String?   @db.Uuid
  positionId   String?   @db.Uuid
  clinicId     String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  department Department? @relation(fields: [departmentId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])
  clinic     Clinic?     @relation("ClinicUsers", fields: [clinicId], references: [id])

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  KASIR
  ADMIN
  SAMPLING
  ANALIS
  DOKTER
  CS
  MARKETING
  KLINIK_PARTNER
}

// === RBAC: Permission System ===

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // e.g., "patients.create", "orders.read", "lab.verify"
  name        String // Human-readable: "Buat Pasien Baru"
  description String?
  resource    String // Resource group: "patients", "orders", "lab", "users", "master-data"
  action      String // Action: "create", "read", "update", "delete", "verify", "approve"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  role         Role // References the Role enum (SUPER_ADMIN, ADMIN, etc.)
  permissionId String   @db.Uuid
  isGranted    Boolean  @default(true) // Can be used to explicitly deny
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String
  entityName String
  entityId   String   @db.Uuid
  oldValues  Json?
  newValues  Json?
  timestamp  DateTime @default(now())
  ipAddress  String?

  @@index([userId])
  @@index([entityName, entityId])
  @@map("audit_logs")
}

// === ENUMS ===

enum Gender {
  MALE
  FEMALE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_OVERDUE
  DEPOSIT_RECEIVED
  PAID
  SAMPLE_COLLECTED
  IN_ANALYSIS
  VERIFIED
  APPROVED
  NOTIFIED
  CANCELLED
}

enum OrderDetailStatus {
  PENDING
  RESULT_ENTERED
  VERIFIED
  APPROVED
}

enum Flag {
  NORMAL
  LOW
  HIGH
  CRITICAL
}

enum PaymentMethod {
  CASH
  BPJS
  TRANSFER
  INSURANCE
  EDC
  INSURANCE_CASH_FALLBACK
  CORPORATE_DEFERRED
}

enum VisitStatus {
  REGISTERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SampleCondition {
  ACCEPTABLE
  LIPEMIC
  HEMOLYTIC
  HEMOLYZED
  CLOTTED
  INSUFFICIENT
  OTHER
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum NotificationType {
  EMAIL
  WHATSAPP
}

// === MASTER DATA ===

model TestCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tests TestMaster[]

  @@map("test_categories")
}

model TestMaster {
  id                       String     @id @default(uuid()) @db.Uuid
  code                     String     @unique
  name                     String
  categoryId               String     @db.Uuid
  unit                     String?
  method                   String?
  sampleType               String?
  price                    Decimal    @db.Decimal(12, 2)
  requiresDoctorApproval   Boolean    @default(true)
  requiresInsurancePreAuth Boolean    @default(false) // Tests requiring insurance pre-authorization
  resultType               ResultType @default(NUMERIC)
  qualitativeOptions       String[] // Array of valid values for QUALITATIVE tests
  deltaAlertThreshold      Decimal?   @db.Decimal(5, 2) // Percentage change threshold for delta check alerts
  tatMinutes               Int? // Target TAT dalam menit (misal: 60 = 1 jam, 1440 = 1 hari)
  tatCategory              String?    @db.VarChar(20) // CITO, ROUTINE, STAT
  isActive                 Boolean    @default(true)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  deletedAt                DateTime?

  category            TestCategory          @relation(fields: [categoryId], references: [id])
  referenceValues     ReferenceValue[]
  tariffs             Tariff[]
  panelTests          PanelTest[]
  orderDetails        OrderDetail[]
  reagentTestMappings ReagentTestMapping[]

  @@map("test_masters")
}

enum ResultType {
  NUMERIC
  TEXT
  QUALITATIVE
}

model ReferenceValue {
  id          String   @id @default(uuid()) @db.Uuid
  testId      String   @db.Uuid
  gender      Gender
  minAge      Int      @default(0)
  maxAge      Int      @default(150)
  minRef      Decimal  @db.Decimal(10, 4)
  maxRef      Decimal  @db.Decimal(10, 4)
  criticalMin Decimal? @db.Decimal(10, 4)
  criticalMax Decimal? @db.Decimal(10, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  test TestMaster @relation(fields: [testId], references: [id])

  @@unique([testId, gender, minAge, maxAge])
  @@map("reference_values")
}

model Panel {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  price       Decimal   @db.Decimal(12, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  panelTests PanelTest[]

  @@map("panels")
}

model PanelTest {
  id      String @id @default(uuid()) @db.Uuid
  panelId String @db.Uuid
  testId  String @db.Uuid

  panel Panel      @relation(fields: [panelId], references: [id])
  test  TestMaster @relation(fields: [testId], references: [id])

  @@unique([panelId, testId])
  @@map("panel_tests")
}

model Tariff {
  id            String    @id @default(uuid()) @db.Uuid
  testId        String    @db.Uuid
  clinicId      String?   @db.Uuid
  insuranceId   String?   @db.Uuid
  price         Decimal   @db.Decimal(12, 2)
  discount      Decimal   @default(0) @db.Decimal(5, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  test      TestMaster @relation(fields: [testId], references: [id])
  clinic    Clinic?    @relation(fields: [clinicId], references: [id])
  insurance Insurance? @relation(fields: [insuranceId], references: [id])

  @@unique([testId, clinicId, insuranceId, effectiveFrom])
  @@map("tariffs")
}

// === MASTER DATA: DOCTOR / REFERRAL ===

model Doctor {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  name           String
  specialization String?
  phone          String?
  email          String?
  licenseNumber  String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  orders Order[]
  visits Visit[]

  @@map("doctors")
}

// === MASTER DATA: CLINIC ===

model Clinic {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders  Order[]
  tariffs Tariff[]
  visits  Visit[]
  users   User[]   @relation("ClinicUsers")

  @@map("clinics")
}

// === MASTER DATA: INSURANCE ===

enum InsuranceType {
  BPJS
  SWASTA
  CORPORATE
}

model Insurance {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique
  name      String
  type      InsuranceType?
  phone     String?
  email     String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  orders            Order[]
  tariffs           Tariff[]
  patients          Patient[]
  visits            Visit[]
  patientInsurances PatientInsurance[]
  orderInsurances   OrderInsurance[]   @relation("orderInsurances")
  paymentComponents PaymentComponent[] @relation("paymentComponents")
  batchInvoices     BatchInvoice[]

  @@map("insurances")
}

// === PATIENT-INSURANCE JUNCTION (M2M with priority) ===

model PatientInsurance {
  id               String         @id @default(uuid()) @db.Uuid
  patientId        String         @db.Uuid
  insuranceId      String         @db.Uuid
  memberNumber     String?        @db.VarChar(50) // Insurance member/card number
  policyNumber     String?        @db.VarChar(50) // Policy number
  priority         Int            @default(1) // 1 = primary, 2 = secondary, etc. (1-5)
  type             InsuranceType? // BPJS, SWASTA, CORPORATE
  bpjsClassLevel   Int? // 1, 2, or 3 (for BPJS only)
  validFrom        DateTime?      @db.Date
  validUntil       DateTime?      @db.Date
  isActive         Boolean        @default(true)
  notes            String?
  migrationBatchId String?        @map("migration_batch_id") @db.VarChar(50) // Identifies records created by migration (for rollback)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  patient   Patient   @relation(fields: [patientId], references: [id])
  insurance Insurance @relation(fields: [insuranceId], references: [id])

  @@unique([patientId, insuranceId])
  @@unique([patientId, priority])
  @@index([patientId, priority])
  @@map("patient_insurances")
}

// === MASTER DATA: EQUIPMENT ===

enum EquipmentStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

model Equipment {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique
  name            String
  manufacturer    String?
  model           String?
  serialNumber    String?
  location        String?
  status          EquipmentStatus @default(ACTIVE)
  lastCalibration DateTime?
  nextCalibration DateTime?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  calibrations Calibration[]
  reagents     Reagent[]

  @@map("equipments")
}

// === MASTER DATA: CALIBRATION ===

model Calibration {
  id            String    @id @default(uuid()) @db.Uuid
  equipmentId   String    @db.Uuid
  calibratedAt  DateTime
  /// External calibrators may not be system users — String intentionally used instead of FK to User.
  calibratedBy  String
  result        String // PASS, FAIL
  notes         String?
  nextDueDate   DateTime?
  certificateNo String?
  createdAt     DateTime  @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId])
  @@map("calibrations")
}

// === MASTER DATA: REAGENT ===

model Reagent {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique
  name         String
  manufacturer String?
  lotNumber    String?
  expiryDate   DateTime?
  quantity     Int       @default(0)
  unit         String?
  storageTemp  String? // e.g., "2-8°C"
  equipmentId  String?   @db.Uuid
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  equipment           Equipment?           @relation(fields: [equipmentId], references: [id])
  reagentTestMappings ReagentTestMapping[]

  @@map("reagents")
}

model ReagentTestMapping {
  id           String   @id @default(uuid()) @db.Uuid
  reagentId    String   @db.Uuid
  testId       String   @db.Uuid
  usagePerTest Decimal? @db.Decimal(8, 4) // jumlah reagen per 1x tes

  reagent Reagent    @relation(fields: [reagentId], references: [id])
  test    TestMaster @relation(fields: [testId], references: [id])

  @@unique([reagentId, testId])
  @@map("reagent_test_mappings")
}

// === MASTER DATA: SAMPLE TYPE ===

model SampleTypeMaster {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique
  name         String
  container    String? // e.g., "EDTA Tube", "SST Tube"
  instructions String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("sample_types")
}

// === MASTER DATA: MEASUREMENT UNIT ===

model MeasurementUnit {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("measurement_units")
}

// === MASTER DATA: METHOD ===

model MethodMaster {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("methods")
}

// === REGION MASTER DATA ===

model Provinsi {
  id        String   @id // EMSIFA code: "11", "32", etc.
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kabupatenKota KabupatenKota[]
  patients      Patient[]

  @@map("provinsi")
}

model KabupatenKota {
  id         String   @id // EMSIFA code: "1101", "3201", etc.
  provinsiId String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provinsi  Provinsi    @relation(fields: [provinsiId], references: [id])
  kecamatan Kecamatan[]
  patients  Patient[]

  @@index([provinsiId])
  @@map("kabupaten_kota")
}

model Kecamatan {
  id              String   @id // EMSIFA code: "110101", "320101", etc.
  kabupatenKotaId String
  name            String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  kabupatenKota KabupatenKota   @relation(fields: [kabupatenKotaId], references: [id])
  kelurahanDesa KelurahanDesa[]
  patients      Patient[]

  @@index([kabupatenKotaId])
  @@map("kecamatan")
}

model KelurahanDesa {
  id          String   @id // EMSIFA code: "1101012001", etc.
  kecamatanId String
  name        String
  postalCode  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kecamatan Kecamatan @relation(fields: [kecamatanId], references: [id])
  patients  Patient[]

  @@index([kecamatanId])
  @@map("kelurahan_desa")
}

// === PATIENT ===

model Patient {
  id                         String    @id @default(uuid()) @db.Uuid
  mrn                        String    @unique
  nik                        String    @unique
  name                       String
  dateOfBirth                DateTime  @db.Date
  gender                     Gender
  phone                      String?
  address                    String?
  email                      String?
  // Phase G: Geographic fields for analytics
  province                   String?
  city                       String?
  district                   String?
  village                    String?
  postalCode                 String?
  // Region FK fields (nullable for backward compatibility)
  provinsiId                 String?
  kabupatenKotaId            String?
  kecamatanId                String?
  kelurahanDesaId            String?
  // Clinical fields
  bloodType                  String?
  emergencyContact           String?
  emergencyPhone             String?
  /// @deprecated — Use PatientInsurance junction (priority=1). Will be removed in v2.
  /// Migration plan: (1) All reads use consolidation service ✅ (2) Writes populate both legacy + junction ✅
  /// (3) Remove field after confirming no direct reads remain — target: v2.0 release
  insuranceId                String?   @db.Uuid
  consentDigitalNotification Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  insurance         Insurance?         @relation(fields: [insuranceId], references: [id])
  patientInsurances PatientInsurance[]
  provinsiRef       Provinsi?          @relation(fields: [provinsiId], references: [id])
  kabupatenKotaRef  KabupatenKota?     @relation(fields: [kabupatenKotaId], references: [id])
  kecamatanRef      Kecamatan?         @relation(fields: [kecamatanId], references: [id])
  kelurahanDesaRef  KelurahanDesa?     @relation(fields: [kelurahanDesaId], references: [id])
  orders            Order[]
  visits            Visit[]

  @@index([phone])
  @@map("patients")
}

// === ORDER ===

model Order {
  id                String           @id @default(uuid()) @db.Uuid
  orderNumber       String           @unique
  patientId         String           @db.Uuid
  clinicId          String?          @db.Uuid
  doctorId          String?          @db.Uuid
  /// @deprecated — Use OrderInsurance junction (coverageType=PRIMARY). Will be removed in v2.
  /// Migration plan: (1) All reads use orderInsurances relation ✅ (2) Writes populate both legacy + junction ✅
  /// (3) Remove field after confirming no direct reads remain — target: v2.0 release
  insuranceId       String?          @db.Uuid
  visitId           String           @db.Uuid
  status            OrderStatus      @default(PENDING_PAYMENT)
  priority          OrderPriority?   @default(ROUTINE)
  totalAmount       Decimal          @db.Decimal(12, 2)
  paymentMethod     PaymentMethod?
  amountPaid        Decimal?         @db.Decimal(12, 2)
  paidAt            DateTime?
  paidBy            String?          @db.Uuid
  barcode           String?
  barcodeImage      String?
  barcodeText       String?          @db.VarChar(100) // Deterministic text for on-demand barcode regeneration
  sampleCollectedAt DateTime?
  sampleCollectedBy String?          @db.Uuid
  sampleCondition   SampleCondition?
  rejectionReason   String?
  verifiedAt        DateTime?
  verifiedBy        String?          @db.Uuid
  verificationNotes String?
  approvedAt        DateTime?
  approvedBy        String?          @db.Uuid
  interpretation    String?
  secondApprovalRequired Boolean     @default(false)
  secondApprovalBy  String?          @db.Uuid
  secondApprovalAt  DateTime?
  rejectedReason    String?
  rejectedAt        DateTime?
  rejectedBy        String?          @db.Uuid
  notifiedAt        DateTime?
  cancelledAt       DateTime?
  cancelledBy       String?          @db.Uuid
  cancelReason      String?
  discountAmount    Decimal?         @db.Decimal(12, 2)
  discountReason    String?
  reportVersion     Int              @default(1)
  depositAmount     Decimal?         @db.Decimal(12, 2)
  receiptNumber     String?          @unique @db.VarChar(30)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  patient           Patient            @relation(fields: [patientId], references: [id])
  clinic            Clinic?            @relation(fields: [clinicId], references: [id])
  doctor            Doctor?            @relation(fields: [doctorId], references: [id])
  insurance         Insurance?         @relation(fields: [insuranceId], references: [id])
  visit             Visit              @relation(fields: [visitId], references: [id], onDelete: Restrict)
  orderDetails      OrderDetail[]
  notifications     NotificationLog[]
  orderInsurances   OrderInsurance[]
  bpjsDetail        BpjsOrderDetail?
  paymentComponents PaymentComponent[]
  batchInvoiceItems BatchInvoiceItem[]
  specimens         Specimen[]
  addendums         OrderAddendum[]
  refunds           Refund[]

  @@index([status])
  @@index([patientId])
  @@index([createdAt])
  @@map("orders")
}

enum OrderPriority {
  ROUTINE
  URGENT
  CITO
}

// === ORDER-INSURANCE JUNCTION (primary/secondary coverage + claim tracking) ===

enum CoverageType {
  PRIMARY
  SECONDARY
}

enum ClaimStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
}

model OrderInsurance {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @db.Uuid
  insuranceId      String       @db.Uuid
  coverageType     CoverageType @default(PRIMARY)
  claimReference   String?      @db.VarChar(50) // Insurance claim number
  claimStatus      ClaimStatus  @default(PENDING)
  coveredAmount    Decimal?     @db.Decimal(12, 2) // Amount covered by this insurance
  copayAmount      Decimal?     @db.Decimal(12, 2) // Patient co-pay for this coverage
  memberNumber     String?      @db.VarChar(50) // Member number used for this claim
  migrationBatchId String?      @map("migration_batch_id") @db.VarChar(50) // Identifies records created by migration (for rollback)
  submittedAt      DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order     Order     @relation(fields: [orderId], references: [id])
  insurance Insurance @relation(fields: [insuranceId], references: [id], name: "orderInsurances")

  @@unique([orderId, coverageType])
  @@index([orderId])
  @@index([claimStatus])
  @@index([insuranceId, claimStatus])
  @@map("order_insurances")
}

// === BPJS ORDER DETAIL ===

enum BpjsVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

model BpjsOrderDetail {
  id                    String                 @id @default(uuid()) @db.Uuid
  orderId               String                 @unique @db.Uuid
  sepNumber             String?                @db.VarChar(19) // SEP number, max 19 chars
  verificationStatus    BpjsVerificationStatus @default(PENDING)
  referringFacilityCode String?                @db.VarChar(20) // Faskes perujuk code
  referringFacilityName String? // Nama faskes perujuk
  classLevel            Int? // 1, 2, or 3
  diagnosisCode         String?                @db.VarChar(10) // ICD-10 code
  diagnosisName         String?
  procedureCode         String?                @db.VarChar(10) // INA-CBG procedure code
  guaranteeLetterNo     String?                @db.VarChar(50) // Surat Jaminan number
  coB                   Decimal?               @db.Decimal(12, 2) // Coordination of Benefits amount
  verifiedAt            DateTime?
  verifiedBy            String?                @db.Uuid
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([sepNumber])
  @@index([verificationStatus])
  @@map("bpjs_order_details")
}

// === PAYMENT COMPONENT (split payment support) ===

model PaymentComponent {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @db.Uuid
  paymentMethod        PaymentMethod
  amount               Decimal       @db.Decimal(12, 2)
  insuranceId          String?       @db.Uuid
  reference            String?       @db.VarChar(100) // Transaction reference (e.g., bank transfer ref, EDC approval code)
  notes                String?
  reconciliationStatus String?       @db.VarChar(20) // MATCHED, UNMATCHED, PENDING
  reconciledAt         DateTime?
  reconciliationRef    String?       @db.VarChar(100)
  paidAt               DateTime      @default(now())
  createdAt            DateTime      @default(now())

  order     Order      @relation(fields: [orderId], references: [id])
  insurance Insurance? @relation(fields: [insuranceId], references: [id], name: "paymentComponents")

  @@index([orderId])
  @@map("payment_components")
}

// === BATCH INVOICE (Corporate Insurance) ===

enum BatchInvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model BatchInvoice {
  id            String             @id @default(uuid()) @db.Uuid
  invoiceNumber String             @unique
  insuranceId   String             @db.Uuid
  periodStart   DateTime           @db.Date
  periodEnd     DateTime           @db.Date
  totalAmount   Decimal            @db.Decimal(14, 2)
  orderCount    Int
  status        BatchInvoiceStatus @default(DRAFT)
  dueDate       DateTime?          @db.Date
  sentAt        DateTime?
  paidAt        DateTime?
  paidAmount    Decimal?           @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  insurance Insurance          @relation(fields: [insuranceId], references: [id])
  items     BatchInvoiceItem[]

  @@index([insuranceId, status])
  @@index([status])
  @@map("batch_invoices")
}

model BatchInvoiceItem {
  id             String @id @default(uuid()) @db.Uuid
  batchInvoiceId String @db.Uuid
  orderId        String @db.Uuid

  batchInvoice BatchInvoice @relation(fields: [batchInvoiceId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])

  @@unique([batchInvoiceId, orderId])
  @@map("batch_invoice_items")
}

// === SEQUENCE TABLE (for Batch Invoice Number) ===

model BatchInvoiceSequence {
  id        String @id // format: "YYYYMM" e.g. "202507"
  lastValue Int    @default(0)

  @@map("batch_invoice_sequences")
}

model OrderDetail {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @db.Uuid
  testId          String            @db.Uuid
  status          OrderDetailStatus @default(PENDING)
  resultValue     String?
  flag            Flag?
  comment         String?
  price           Decimal           @db.Decimal(12, 2)
  discount        Decimal           @default(0) @db.Decimal(5, 2)
  finalPrice      Decimal           @db.Decimal(12, 2)
  resultEnteredAt DateTime?
  resultEnteredBy String?           @db.Uuid
  verifiedAt      DateTime?
  verifiedBy      String?           @db.Uuid
  rejectedAt      DateTime?
  rejectedBy      String?           @db.Uuid
  rejectionReason String?
  rerunCount      Int               @default(0)
  rerunReason     String?           @db.VarChar(50) // enum stored as string: QC_FAILURE, SPECIMEN_ISSUE, EQUIPMENT_ERROR, OPERATOR_ERROR, OTHER
  previousResults Json? // Array of {value, flag, enteredAt, enteredBy}
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  order Order      @relation(fields: [orderId], references: [id])
  test  TestMaster @relation(fields: [testId], references: [id])

  @@index([orderId])
  @@index([testId, resultEnteredAt(sort: Desc)])
  @@map("order_details")
}

// === NOTIFICATION ===

model NotificationLog {
  id        String             @id @default(uuid()) @db.Uuid
  orderId   String             @db.Uuid
  type      NotificationType
  recipient String
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0) // MED-028: retry count (number of delivery attempts made)
  lastError String?            // MED-028: last error message from failed delivery attempt
  sentAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("notification_logs")
}

// === SEQUENCE TABLE (for MRN) ===

model MrnSequence {
  id        String @id // format: "YYYYMM" e.g. "202507"
  lastValue Int    @default(0)

  @@map("mrn_sequences")
}

// === VISIT ===

model Visit {
  id                  String        @id @default(uuid()) @db.Uuid
  visitNumber         String        @unique @db.VarChar(50)
  status              VisitStatus   @default(REGISTERED)
  registrationDate    DateTime      @default(now())
  patientId           String        @db.Uuid
  doctorId            String?       @db.Uuid
  clinicId            String?       @db.Uuid
  paymentMethod       PaymentMethod
  insuranceId         String?       @db.Uuid
  bpjsNumber          String?       @db.VarChar(20)
  referringDoctorName String?       @db.VarChar(100)
  referralLetterNo    String?       @db.VarChar(50)
  encounterReason     String?
  chiefComplaint      String?
  cancelledAt         DateTime?
  cancelReason        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id])
  doctor    Doctor?    @relation(fields: [doctorId], references: [id])
  clinic    Clinic?    @relation(fields: [clinicId], references: [id])
  insurance Insurance? @relation(fields: [insuranceId], references: [id])
  orders    Order[]

  @@index([status])
  @@index([patientId, registrationDate])
  @@map("visits")
}

// === SEQUENCE TABLE (for Visit Number) ===

model VisitSequence {
  id        String @id // format: "YYYYMM" e.g. "202507"
  lastValue Int    @default(0)

  @@map("visit_sequences")
}

// === SYSTEM SETTINGS ===

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// === APPROVAL WORKFLOW ===

enum ApprovalType {
  TARIFF_CHANGE
  HIGH_VALUE_ORDER
  MASTER_DATA_DELETE
  DISCOUNT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id           String         @id @default(uuid()) @db.Uuid
  requestType  ApprovalType
  requesterId  String         @db.Uuid
  currentLevel Int            @default(1)
  maxLevel     Int            @default(1)
  status       ApprovalStatus @default(PENDING)
  payload      Json
  reason       String?
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  steps ApprovalStep[]

  @@index([requestType, status])
  @@map("approval_requests")
}

model ApprovalStep {
  id                String   @id @default(uuid()) @db.Uuid
  approvalRequestId String   @db.Uuid
  level             Int
  approverId        String   @db.Uuid
  action            String
  comment           String?
  actedAt           DateTime @default(now())

  request ApprovalRequest @relation(fields: [approvalRequestId], references: [id])

  @@index([approvalRequestId])
  @@map("approval_steps")
}

// === DEPARTMENT & POSITION ===

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions Position[]
  users     User[]

  @@map("departments")
}

model Position {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  departmentId String   @db.Uuid
  level        Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  users      User[]

  @@map("positions")
}

// === ROLE HIERARCHY ===

model RoleHierarchy {
  id         String @id @default(uuid()) @db.Uuid
  role       Role   @unique
  parentRole Role?
  level      Int    @default(0)

  @@map("role_hierarchy")
}


// === SPECIMEN TRACKING ===

model Specimen {
  id                   String          @id @default(uuid()) @db.Uuid
  orderId              String          @db.Uuid
  sampleTypeCode       String          @db.VarChar(20)
  barcode              String          @unique @db.VarChar(50)
  condition            SampleCondition @default(ACCEPTABLE)
  rejectionReason      String?         @db.VarChar(200)
  transportTemperature Decimal?        @db.Decimal(4, 1)
  temperatureCompliant Boolean?
  collectedAt          DateTime?
  collectedBy          String?         @db.Uuid
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  order              Order                    @relation(fields: [orderId], references: [id])
  collectionAttempts SampleCollectionAttempt[]
  handoffs           CustodyHandoff[]

  @@index([orderId])
  @@index([barcode])
  @@map("specimens")
}

model SampleCollectionAttempt {
  id              String          @id @default(uuid()) @db.Uuid
  orderId         String          @db.Uuid
  specimenId      String          @db.Uuid
  sampleCondition SampleCondition
  rejectionReason String?         @db.VarChar(200)
  collectedBy     String          @db.Uuid
  attemptedAt     DateTime        @default(now())

  specimen Specimen @relation(fields: [specimenId], references: [id])

  @@index([specimenId])
  @@index([orderId])
  @@map("sample_collection_attempts")
}

model CustodyHandoff {
  id         String   @id @default(uuid()) @db.Uuid
  specimenId String   @db.Uuid
  fromUserId String   @db.Uuid
  toUserId   String   @db.Uuid
  handoffAt  DateTime @default(now())
  notes      String?

  specimen Specimen @relation(fields: [specimenId], references: [id])

  @@index([specimenId])
  @@map("custody_handoffs")
}

// === QUALITY CONTROL ===

model QCSample {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  lotNumber    String   @db.VarChar(50)
  manufacturer String?
  level        Int // 1 = normal, 2 = abnormal low, 3 = abnormal high
  expiryDate   DateTime @db.Date
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs QCRun[]

  @@map("qc_samples")
}

model QCRun {
  id          String   @id @default(uuid()) @db.Uuid
  qcSampleId  String   @db.Uuid
  testId      String   @db.Uuid
  equipmentId String?  @db.Uuid
  runDate     DateTime @default(now())
  performedBy String   @db.Uuid
  notes       String?
  createdAt   DateTime @default(now())

  qcSample QCSample   @relation(fields: [qcSampleId], references: [id])
  results  QCResult[]

  @@index([qcSampleId, testId])
  @@map("qc_runs")
}

model QCResult {
  id           String  @id @default(uuid()) @db.Uuid
  qcRunId      String  @db.Uuid
  resultValue  Decimal @db.Decimal(12, 4)
  expectedMean Decimal @db.Decimal(12, 4)
  expectedSD   Decimal @db.Decimal(12, 4)
  zScore       Decimal @db.Decimal(6, 3)
  westgardPass Boolean
  violatedRule String? @db.VarChar(10) // e.g., "1-3s", "R-4s"

  qcRun QCRun @relation(fields: [qcRunId], references: [id])

  @@index([qcRunId])
  @@map("qc_results")
}

// === CRITICAL VALUE ALERTING ===

enum CriticalValueStatus {
  PENDING
  NOTIFIED
  ACKNOWLEDGED
  ESCALATED
}

model CriticalValueLog {
  id                  String              @id @default(uuid()) @db.Uuid
  orderId             String              @db.Uuid
  orderDetailId       String              @db.Uuid
  testId              String              @db.Uuid
  patientId           String              @db.Uuid
  resultValue         String
  flaggedAt           DateTime            @default(now())
  notificationStatus  CriticalValueStatus @default(PENDING)
  notifiedAt          DateTime?
  acknowledgedAt      DateTime?
  acknowledgedBy      String?             @db.Uuid
  acknowledgmentNotes String?
  escalatedAt         DateTime?
  escalationMethod    String?             @db.VarChar(20) // SMS, CALL
  clinicianId         String?             @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([orderId])
  @@index([notificationStatus])
  @@index([patientId])
  @@map("critical_value_logs")
}

// === ORDER ADDENDUM ===

model OrderAddendum {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  authorId  String   @db.Uuid
  content   String
  version   Int      @default(1)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_addendums")
}

// === REFUND ===

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

model Refund {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  reason       String
  status       RefundStatus  @default(PENDING)
  refundMethod PaymentMethod?
  processedAt  DateTime?
  processedBy  String?       @db.Uuid
  reference    String?       @db.VarChar(100)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

// === PRICING ===

model PriceList {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  type          String    @db.VarChar(30) // CORPORATE, INSURANCE, PROMOTION, PACKAGE
  entityId      String?   @db.Uuid // Reference to insurance/clinic/corporate
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items PriceListItem[]

  @@index([type, isActive])
  @@map("price_lists")
}

model PriceListItem {
  id          String  @id @default(uuid()) @db.Uuid
  priceListId String  @db.Uuid
  testId      String  @db.Uuid
  price       Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id])

  @@unique([priceListId, testId])
  @@map("price_list_items")
}

// === RECEIPT SEQUENCE ===

model ReceiptSequence {
  id        String @id // format: "YYYYMMDD"
  lastValue Int    @default(0)

  @@map("receipt_sequences")
}

// === ORDER SEQUENCE ===

model OrderSequence {
  id        String @id // format: "YYYYMM"
  lastValue Int    @default(0)

  @@map("order_sequences")
}
